[Unit]
Description=Telegram Bot Listener for Trading System
After=network.target
Wants=network.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading_bot
ExecStart=/opt/trading_bot/venv/bin/python /opt/trading_bot/telegram_bot_listener.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot-listener

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/trading_bot/logs /opt/trading_bot/data
ProtectHome=yes

# Resource limits
MemoryLimit=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target