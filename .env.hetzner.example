# Hetzner Export Configuration Example
# Copy to .env.hetzner and fill with real values before running export scripts.
export HETZNER_HOST="your.hetzner.host"
export HETZNER_USER="your_username"
export SSH_KEY_PATH="/absolute/path/to/hetzner_key"
export SSH_PORT="22"

# Optional overrides
# export CONNECTION_TIMEOUT="30"
# export TRANSFER_TIMEOUT="3600"
