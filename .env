# Environment Configuration for Cryptocurrency Data Collection
# This file contains only the environment variables used by the current scripts.

# =============================================================================
# DATA COLLECTION CONFIGURATION
# =============================================================================
# Cryptocurrency symbols to collect data for (comma-separated)
SYMBOLS=BTCEUR,ETHEUR,ADAEUR,SOLEUR,XRPEUR

# Time intervals for data collection (comma-separated)
INTERVALS=15m

# Start date for historical data collection (YYYY-MM-DD)
START_DATE=2020-01-01

# Directory to store collected data
DATA_DIR=data

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================
# Maximum API requests per minute
MAX_REQUESTS_PER_MINUTE=6

# Burst capacity for rate limiting
BURST_CAPACITY=2

# API batch size for bulk requests
API_BATCH_SIZE=50

# Number of days to use API-only data collection
API_ONLY_DAYS=3

# =============================================================================
# RETRY AND BACKOFF SETTINGS
# =============================================================================
# Maximum retries for API requests
API_MAX_RETRIES=3

# Maximum retries for bulk data requests
BULK_MAX_RETRIES=5

# Base delay for exponential backoff (seconds)
BASE_BACKOFF_DELAY=10.0

# Maximum delay for exponential backoff (seconds)
MAX_BACKOFF_DELAY=600.0

# Circuit breaker reset delay (seconds)
CIRCUIT_RESET_DELAY=3600

# Maximum API failures before circuit breaker triggers
MAX_API_FAILURES=3

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Delay between bulk requests (seconds)
BULK_REQUEST_DELAY=0.5

# Delay between API requests (seconds)
API_REQUEST_DELAY=0.5

# Chunk size for data processing
CHUNK_SIZE=10000

# Maximum memory usage in MB
MAX_MEMORY_MB=500

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# Database connection pool size
DB_POOL_SIZE=5

# Database operation timeout (seconds)
DB_TIMEOUT=30

# Batch insert size for database operations
BATCH_INSERT_SIZE=1000

# =============================================================================
# RESUME SETTINGS
# =============================================================================
# State file for resume capability
STATE_FILE=data/collector_state.json

# Enable automatic resume on restart
AUTO_RESUME=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO