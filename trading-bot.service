[Unit]
Description=Automated Trading Bot with Tmux
After=network.target
Wants=network.target

[Service]
Type=forking
User=trader
Group=trader
WorkingDirectory=/opt/trading_bot/bot
EnvironmentFile=/etc/trading_bot/.env
ExecStartPre=/bin/bash -c "cd /opt/trading_bot/bot && git pull"
ExecStart=/bin/bash -c "cd /opt/trading_bot/bot && ./scripts/tmux_manager.sh start"
ExecStop=/bin/bash -c "cd /opt/trading_bot/bot && ./scripts/tmux_manager.sh stop"
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/trading_bot/bot /var/log/trading_bot
ProtectHome=yes

# Resource limits
MemoryLimit=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target