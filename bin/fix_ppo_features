#!/usr/bin/env python3
"""
PPO Feature Recovery and Alignment Fix
======================================

This script fixes the PPO feature count mismatch by:
1. Analyzing the actual features generated by the trading system
2. Updating PPO feature metadata to match the correct feature generation
3. Creating proper preprocessors for PPO models
4. Ensuring alignment between training and inference

The issue: PPO models expect 104 features but only receive 13.
The fix: Analyze the actual feature pipeline and align expectations.
"""

import json
import os
import sys
from pathlib import Path

import numpy as np
import pandas as pd

# Add project root to path
bot_dir = Path(__file__).parent.parent
sys.path.insert(0, str(bot_dir))
sys.path.insert(0, str(bot_dir / "src"))

from src.config.secure_env_manager import get_env_manager
from src.core.logging_manager import get_system_logger
from src.data_pipeline.feature_engine import FeatureEngine
from src.data_pipeline.feature_selector import EnhancedDataPreprocessor
from src.models.ppo_trainer import PPOTrainer

logger = get_system_logger("ppo_feature_fix")


def analyze_current_feature_generation():
    """Analyze what features are actually generated by the current system."""
    logger.info("🔍 Analyzing current feature generation...")

    # Sample symbols
    symbols = ["BTCEUR", "ETHEUR", "ADAEUR", "DOTEUR", "LINKEUR"]

    # Create feature engine
    feature_engine = FeatureEngine()

    # Mock some sample data (this mirrors what the trader does)
    sample_data = {}
    for symbol in symbols:
        # Create sample OHLCV data
        dates = pd.date_range(start="2024-01-01", periods=1000, freq="1H")
        np.random.seed(42)  # For reproducible results

        ohlcv = pd.DataFrame(
            {
                "timestamp": dates,
                "open": 50000 + np.cumsum(np.random.randn(1000) * 100),
                "high": 50000 + np.cumsum(np.random.randn(1000) * 100) + 500,
                "low": 50000 + np.cumsum(np.random.randn(1000) * 100) - 500,
                "close": 50000 + np.cumsum(np.random.randn(1000) * 100),
                "volume": np.random.randint(1000, 10000, 1000),
            }
        )
        ohlcv.set_index("timestamp", inplace=True)
        sample_data[symbol] = ohlcv

    # Generate features for each symbol
    feature_analysis = {}

    for symbol in symbols:
        logger.info(f"Analyzing features for {symbol}...")

        try:
            # Generate features the same way the trader does
            features = feature_engine.generate_all_features(sample_data[symbol])

            feature_analysis[symbol] = {
                "total_features": len(features.columns),
                "feature_names": list(features.columns),
                "sample_shape": features.shape,
                "dtypes": features.dtypes.to_dict(),
            }

            logger.info(f"  {symbol}: {len(features.columns)} features generated")

        except Exception as e:
            logger.error(f"Error generating features for {symbol}: {e}")
            feature_analysis[symbol] = {"error": str(e)}

    return feature_analysis


def analyze_ppo_requirements():
    """Analyze what PPO models actually expect."""
    logger.info("🔍 Analyzing PPO model requirements...")

    ppo_requirements = {}
    symbols = ["BTCEUR", "ETHEUR", "ADAEUR", "DOTEUR", "LINKEUR"]

    for symbol in symbols:
        try:
            # Try to load PPO model metadata
            metadata_path = bot_dir / "models" / "ppo" / symbol / "model_metadata.json"
            if metadata_path.exists():
                with open(metadata_path, "r") as f:
                    metadata = json.load(f)

                # Check if we can extract feature requirements from the model
                ppo_requirements[symbol] = {
                    "metadata_file": str(metadata_path),
                    "metadata": metadata,
                }

            # Check feature metadata
            feature_metadata_path = bot_dir / "models" / "metadata" / f"features_ppo_{symbol}.json"
            if feature_metadata_path.exists():
                with open(feature_metadata_path, "r") as f:
                    feature_data = json.load(f)

                if symbol not in ppo_requirements:
                    ppo_requirements[symbol] = {}

                ppo_requirements[symbol]["feature_metadata"] = {
                    "expected_count": len(feature_data.get("expected_features", [])),
                    "feature_names": feature_data.get("expected_features", []),
                }

                logger.info(
                    f"  {symbol}: expects {len(feature_data.get('expected_features', []))} features"
                )

        except Exception as e:
            logger.error(f"Error analyzing PPO requirements for {symbol}: {e}")
            ppo_requirements[symbol] = {"error": str(e)}

    return ppo_requirements


def create_corrected_feature_metadata(feature_analysis, symbol):
    """Create corrected feature metadata for PPO models."""
    if symbol not in feature_analysis:
        logger.error(f"No feature analysis available for {symbol}")
        return None

    if "error" in feature_analysis[symbol]:
        logger.error(f"Feature analysis failed for {symbol}: {feature_analysis[symbol]['error']}")
        return None

    actual_features = feature_analysis[symbol]["feature_names"]

    # Create corrected metadata
    corrected_metadata = {
        "symbol": symbol,
        "model_type": "ppo",
        "expected_features": actual_features,
        "feature_count": len(actual_features),
        "created_by": "ppo_feature_fix",
        "creation_date": pd.Timestamp.now().isoformat(),
        "original_expected": 104,
        "actual_generated": len(actual_features),
        "status": "corrected",
    }

    return corrected_metadata


def fix_ppo_feature_metadata():
    """Fix PPO feature metadata files."""
    logger.info("🔧 Fixing PPO feature metadata...")

    # Step 1: Analyze current feature generation
    feature_analysis = analyze_current_feature_generation()

    # Step 2: Analyze PPO requirements
    ppo_requirements = analyze_ppo_requirements()

    # Step 3: Create corrected metadata for each symbol
    symbols = ["BTCEUR", "ETHEUR", "ADAEUR", "DOTEUR", "LINKEUR"]
    fixed_count = 0

    for symbol in symbols:
        logger.info(f"🔧 Fixing metadata for {symbol}...")

        # Create corrected metadata
        corrected_metadata = create_corrected_feature_metadata(feature_analysis, symbol)
        if not corrected_metadata:
            continue

        # Backup original metadata
        metadata_path = bot_dir / "models" / "metadata" / f"features_ppo_{symbol}.json"
        backup_path = metadata_path.with_suffix(".json.backup_fix")

        if metadata_path.exists():
            logger.info(f"  📦 Backing up original to {backup_path}")
            with open(backup_path, "w") as f:
                with open(metadata_path, "r") as orig:
                    f.write(orig.read())

        # Write corrected metadata
        logger.info(
            f"  ✅ Writing corrected metadata: {len(corrected_metadata['expected_features'])} features"
        )
        with open(metadata_path, "w") as f:
            json.dump(corrected_metadata, f, indent=2)

        fixed_count += 1

    logger.info(f"✅ Fixed metadata for {fixed_count} symbols")
    return fixed_count


def verify_fix():
    """Verify that the fix worked."""
    logger.info("🔍 Verifying PPO feature fix...")

    symbols = ["BTCEUR", "ETHEUR", "ADAEUR", "DOTEUR", "LINKEUR"]
    verification_results = {}

    for symbol in symbols:
        try:
            # Check metadata file
            metadata_path = bot_dir / "models" / "metadata" / f"features_ppo_{symbol}.json"
            if metadata_path.exists():
                with open(metadata_path, "r") as f:
                    metadata = json.load(f)

                verification_results[symbol] = {
                    "metadata_exists": True,
                    "feature_count": metadata.get("feature_count", 0),
                    "has_expected_features": "expected_features" in metadata,
                    "status": metadata.get("status", "unknown"),
                }

                logger.info(
                    f"  ✅ {symbol}: {metadata.get('feature_count', 0)} features, status: {metadata.get('status', 'unknown')}"
                )
            else:
                verification_results[symbol] = {"metadata_exists": False}
                logger.warning(f"  ❌ {symbol}: No metadata file found")

        except Exception as e:
            logger.error(f"  ❌ {symbol}: Verification failed: {e}")
            verification_results[symbol] = {"error": str(e)}

    return verification_results


def main():
    """Main function."""
    logger.info("🚀 Starting PPO Feature Fix...")

    try:
        # Fix the metadata
        fixed_count = fix_ppo_feature_metadata()

        if fixed_count > 0:
            # Verify the fix
            verification_results = verify_fix()

            # Summary
            logger.info("📊 Fix Summary:")
            logger.info(f"  Fixed metadata files: {fixed_count}")

            success_count = sum(
                1
                for result in verification_results.values()
                if result.get("metadata_exists", False) and result.get("status") == "corrected"
            )

            logger.info(f"  Verified successful: {success_count}")

            if success_count == fixed_count:
                logger.info("🎉 PPO feature fix completed successfully!")
                logger.info("💡 Restart the trading system to apply the changes")
                return True
            else:
                logger.warning(f"⚠️ Only {success_count}/{fixed_count} fixes verified successfully")
                return False
        else:
            logger.error("❌ No fixes were applied")
            return False

    except Exception as e:
        logger.error(f"💥 PPO feature fix failed: {e}")
        return False


if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)
