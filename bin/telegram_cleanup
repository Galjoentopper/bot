#!/usr/bin/env python3
"""
Telegram Bot Cleanup Utility
=============================

Force cleanup utility for Telegram bot instances and lock files.
Use this when the bot gets stuck in a bad state.
"""

import asyncio
import os
import signal
import sys
import time
from pathlib import Path

# Ensure the bot directory is in the Python path
bot_dir = Path(__file__).parent.parent
sys.path.insert(0, str(bot_dir))

from src.core.logging_manager import get_system_logger


def _find_telegram_processes():
    """Return a list of PIDs for known telegram-related processes."""
    try:
        import psutil

        pids = []
        for proc in psutil.process_iter(["pid", "name", "cmdline"]):
            try:
                cmdline = " ".join(proc.info.get("cmdline") or [])
                if (
                    any(
                        key in cmdline
                        for key in (
                            "bin/telegram_bot",
                            "telegram_launcher",
                            "Unified Telegram Service",
                            "src/notifications/telegram_service.py",
                        )
                    )
                    and proc.pid != os.getpid()
                ):
                    pids.append(proc.pid)
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
        return pids
    except ImportError:
        # Fallback: use pkill patterns; cannot enumerate without psutil
        return []


def cleanup_processes():
    """Kill any lingering telegram bot processes."""
    logger = get_system_logger("telegram_cleanup")

    try:
        # Find and kill python processes running telegram bot
        import psutil

        killed_processes = []
        for pid in _find_telegram_processes():
            try:
                proc = psutil.Process(pid)
                cmdline = " ".join(proc.cmdline() or [])
                logger.info(f"Found telegram bot process PID {proc.pid}: {cmdline}")
                proc.terminate()
                killed_processes.append(proc.pid)
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue

        # Wait for processes to terminate, then force kill if needed
        if killed_processes:
            time.sleep(2)
            for pid in killed_processes:
                try:
                    proc = psutil.Process(pid)
                    if proc.is_running():
                        logger.warning(f"Force killing PID {pid}")
                        proc.kill()
                except psutil.NoSuchProcess:
                    continue

            logger.info(f"Cleaned up {len(killed_processes)} telegram bot processes")
        else:
            logger.info("No telegram bot processes found")

    except ImportError:
        logger.warning("psutil not available, using pkill fallback")
        os.system("pkill -f 'bin/telegram_bot' || true")
        os.system("pkill -f 'telegram_launcher' || true")
        os.system("pkill -f 'telegram_service' || true")


def cleanup_locks():
    """Clean up any legacy lock files from old implementations."""
    logger = get_system_logger("telegram_cleanup")

    # Legacy singleton locks used by deprecated bot implementation
    legacy_lock_paths = [
        Path("/tmp/telegram_bot.lock"),
        Path("/tmp/unified_telegram_service.lock"),
        Path("/tmp/trading_bot_telegram.lock"),
    ]

    cleaned = 0
    for lock_path in legacy_lock_paths:
        if lock_path.exists():
            try:
                lock_path.unlink()
                logger.info(f"Removed legacy lock file: {lock_path}")
                cleaned += 1
            except Exception as e:
                logger.warning(f"Could not remove lock {lock_path}: {e}")

    if cleaned == 0:
        logger.info("No legacy lock files found")
    else:
        logger.info(f"✅ Cleaned up {cleaned} legacy lock file(s)")


def cleanup_socket_files():
    """Clean up any socket files that might be causing issues."""
    logger = get_system_logger("telegram_cleanup")

    socket_paths = [
        "/tmp/telegram_bot.sock",
        "/tmp/trading_bot_telegram.sock",
        "/var/run/user/{}/telegram_bot.sock".format(os.getuid()) if hasattr(os, "getuid") else None,
    ]

    cleaned = 0
    for socket_path in socket_paths:
        if socket_path and Path(socket_path).exists():
            try:
                Path(socket_path).unlink()
                logger.info(f"Removed socket file: {socket_path}")
                cleaned += 1
            except Exception as e:
                logger.warning(f"Could not remove {socket_path}: {e}")

    if cleaned == 0:
        logger.info("No socket files found to clean")


def main():
    """Main cleanup function."""
    logger = get_system_logger("telegram_cleanup")
    logger.info("🧹 Starting Telegram Bot cleanup...")

    # Step 1: Kill processes
    logger.info("Step 1: Cleaning up processes...")
    cleanup_processes()

    # Step 2: Clean up locks
    logger.info("Step 2: Cleaning up lock files...")
    cleanup_locks()

    # Step 3: Clean up socket files
    logger.info("Step 3: Cleaning up socket files...")
    cleanup_socket_files()

    logger.info("✅ Telegram Bot cleanup completed")

    # Wait a moment for everything to settle
    time.sleep(1)

    # Check if any instances are still running by process scan
    remaining = []
    try:
        remaining = _find_telegram_processes()
    except Exception:
        # If psutil not available, assume success after pkill fallback
        remaining = []

    if remaining:
        logger.warning(f"⚠️ Telegram-related processes still running: {remaining}")
        return False

    logger.info("✅ No telegram bot instances detected")
    return True


if __name__ == "__main__":
    try:
        success = main()
        sys.exit(0 if success else 1)
    except KeyboardInterrupt:
        print("\nCleanup interrupted by user")
        sys.exit(0)
    except Exception as e:
        print(f"Cleanup failed: {e}")
        sys.exit(1)
