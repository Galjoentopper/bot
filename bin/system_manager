#!/bin/bash
# Unified Trading Bot System Manager
# Consolidated system start/stop/status/health functionality

set -e  # Exit on any error

# Configuration variables
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd .. && pwd)"
SKIP_MODEL_COUNT=${SKIP_MODEL_COUNT:-false}
QUIET_MODE=${QUIET_MODE:-false}
FAST_START=${FAST_START:-false}
FORCE_START=${FORCE_START:-false}
CACHE_DIR="/tmp/trading_bot"
CACHE_FILE="$CACHE_DIR/models.cache"

# Tmux configuration
TMUX_SESSION="trading-bot"
TMUX_SOCKET_DIR="${TMUX_TMPDIR:-$SCRIPT_DIR/tmux}"
TMUX_SOCKET="$TMUX_SOCKET_DIR/trading-bot.sock"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Tmux helper function
tmux_cmd() {
    if [ ! -d "$TMUX_SOCKET_DIR" ]; then
        mkdir -p "$TMUX_SOCKET_DIR"
        chmod 700 "$TMUX_SOCKET_DIR"
    fi
    TMUX_TMPDIR="$TMUX_SOCKET_DIR" tmux -S "$TMUX_SOCKET" "$@"
}

# Check if tmux session exists
session_exists() {
    tmux_cmd has-session -t "$TMUX_SESSION" 2>/dev/null
}

# Function to show usage
show_usage() {
    echo "Trading Bot System Manager"
    echo ""
    echo "Usage: $0 {start|stop|restart|status|health|logs}"
    echo ""
    echo "Commands:"
    echo "  start    - Start the trading bot system"
    echo "  stop     - Stop the trading bot system"
    echo "  restart  - Restart the trading bot system"
    echo "  status   - Show system status"
    echo "  health   - Run health checks"
    echo "  logs     - Show system logs"
    echo "  attach   - Attach to tmux session"
    echo "  detach   - Detach from tmux session (when attached)"
    echo ""
    echo "Options:"
    echo "  --fast         Fast start mode"
    echo "  --quiet        Quiet mode"
    echo "  --force        Force start/stop"
    echo "  --skip-models  Skip model validation"
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --fast)
                FAST_START=true
                shift
                ;;
            --quiet)
                QUIET_MODE=true
                shift
                ;;
            --force)
                FORCE_START=true
                shift
                ;;
            --skip-models)
                SKIP_MODEL_COUNT=true
                shift
                ;;
            --help)
                show_usage
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done
}

# Function to check system dependencies
check_dependencies() {
    local failed=0

    log_info "Checking system dependencies..."

    # Check if virtual environment exists
    if [ ! -f "$SCRIPT_DIR/venv/bin/activate" ]; then
        log_error "Virtual environment not found at $SCRIPT_DIR/venv/"
        ((failed++))
    fi

    # Check Python availability
    if ! command -v python3 &> /dev/null; then
        log_error "Python3 not found"
        ((failed++))
    fi

    # Check configuration file
    if [ ! -f "$SCRIPT_DIR/config/training_config.yaml" ]; then
        log_error "Configuration file not found: config/training_config.yaml"
        ((failed++))
    fi

    # Check models directory
    if [ ! -d "$SCRIPT_DIR/models" ]; then
        log_error "Models directory not found"
        ((failed++))
    fi

    if [ $failed -gt 0 ]; then
        log_error "Dependency check failed with $failed error(s)"
        return 1
    fi

    log_success "All dependencies satisfied"
    return 0
}

# Function to start the system
start_system() {
    local start_time=$(date +%s.%N)

    log_info "Starting Trading Bot System..."

    cd "$SCRIPT_DIR"

    # Check dependencies unless forced
    if [ "$FORCE_START" != "true" ]; then
        if ! check_dependencies; then
            log_error "Dependency check failed. Use --force to override."
            exit 1
        fi
    fi

    # Check if session already exists
    if session_exists; then
        log_warning "Trading bot session already running. Use 'restart' to restart."
        tmux_cmd list-sessions -F "#{session_name}: #{session_created_string}"
        return 0
    fi

    # Create logs directory if needed
    mkdir -p "$SCRIPT_DIR/logs"

    # Create tmux session
    log_info "Creating detached tmux session '$TMUX_SESSION'..."
    tmux_cmd new-session -d -s "$TMUX_SESSION" -n "trader"

    # Start the main trader in first window
    log_info "Starting main trader..."
    tmux_cmd send-keys -t "$TMUX_SESSION:trader" "cd $SCRIPT_DIR && source venv/bin/activate" C-m

    if [ "$QUIET_MODE" == "true" ]; then
        tmux_cmd send-keys -t "$TMUX_SESSION:trader" "python bin/trader --config config/training_config.yaml 2>&1 | tee -a logs/trader_$(date +%Y%m%d_%H%M%S).log" C-m
    else
        tmux_cmd send-keys -t "$TMUX_SESSION:trader" "python bin/trader --config config/training_config.yaml 2>&1 | tee -a logs/trader_$(date +%Y%m%d_%H%M%S).log" C-m
    fi

    # Start unified Telegram system in new window
    if [ -x "bin/telegram_bot" ]; then
        log_info "Starting unified Telegram notification system..."
        tmux_cmd new-window -t "$TMUX_SESSION" -n "telegram"
        tmux_cmd send-keys -t "$TMUX_SESSION:telegram" "cd $SCRIPT_DIR && source venv/bin/activate" C-m

        # Start the unified Telegram service
        tmux_cmd send-keys -t "$TMUX_SESSION:telegram" "python bin/telegram_bot 2>&1 | tee -a logs/telegram_$(date +%Y%m%d_%H%M%S).log" C-m

        sleep 2  # Give it time to start
        log_success "Unified Telegram system started in tmux window 'telegram'"
    else
        log_warning "Telegram bot executable not found or not executable at bin/telegram_bot"
    fi

    # Add monitoring window
    tmux_cmd new-window -t "$TMUX_SESSION" -n "monitor"
    tmux_cmd send-keys -t "$TMUX_SESSION:monitor" "cd $SCRIPT_DIR/logs && tail -f *.log" C-m

    local end_time=$(date +%s.%N)
    local runtime=$(echo "$end_time - $start_time" | bc -l)

    log_success "System started successfully in ${runtime}s"
    log_info "Session: $TMUX_SESSION (detached)"
    log_info "To attach to session: tmux -S $TMUX_SOCKET attach -t $TMUX_SESSION"
    log_info "To view without attaching: tmux -S $TMUX_SOCKET capture-pane -t $TMUX_SESSION -p"
}

# Function to stop the system
stop_system() {
    log_info "Stopping Trading Bot System..."

    if session_exists; then
        # Send graceful shutdown signal to telegram bot first
        log_info "Sending graceful shutdown to Telegram bot..."
        tmux_cmd send-keys -t "$TMUX_SESSION:telegram" C-c 2>/dev/null || true
        sleep 2

        # Send interrupt signal to trader
        log_info "Stopping trader..."
        tmux_cmd send-keys -t "$TMUX_SESSION:trader" C-c 2>/dev/null || true
        sleep 1

        # Send interrupt to monitor if it exists
        tmux_cmd send-keys -t "$TMUX_SESSION:monitor" C-c 2>/dev/null || true
        sleep 1

        # Kill the tmux session
        tmux_cmd kill-session -t "$TMUX_SESSION"
        log_success "Tmux session '$TMUX_SESSION' stopped"
    else
        log_warning "No tmux session '$TMUX_SESSION' found"
    fi

    # Force cleanup of telegram bot instances and locks
    log_info "Running Telegram bot cleanup..."
    if [ -x "$SCRIPT_DIR/bin/telegram_cleanup" ]; then
        python3 "$SCRIPT_DIR/bin/telegram_cleanup" || log_warning "Telegram cleanup failed"
    else
        log_warning "Telegram cleanup script not found, using fallback"
        # Fallback cleanup
        pkill -f "bin/telegram_bot" || true
        rm -f /tmp/telegram_bot.lock || true
    fi

    # Clean up any remaining processes
    pkill -f "bin/trader" || true

    # Clean up PID files if they exist
    rm -f /tmp/trading_bot_trader.pid
    rm -f /tmp/trading_bot_telegram.pid

    log_success "System stopped successfully"
}

# Function to check system status
check_status() {
    log_info "Trading Bot System Status:"

    if session_exists; then
        log_success "Tmux session: RUNNING ('$TMUX_SESSION')"
        echo ""
        echo "Active windows:"
        tmux_cmd list-windows -t "$TMUX_SESSION" -F "  - #W: #T"
        echo ""
        echo "Process status:"

        # Check trader window
        if tmux_cmd list-panes -t "$TMUX_SESSION:trader" &>/dev/null; then
            log_success "  Trader: Running"
        else
            log_warning "  Trader: Window not found"
        fi

        # Check telegram window if it exists
        if tmux_cmd list-panes -t "$TMUX_SESSION:telegram" &>/dev/null; then
            log_success "  Telegram: Running"
        else
            log_info "  Telegram: Not configured or not running"
        fi

        echo ""
        echo "To attach to session: tmux -S $TMUX_SOCKET attach -t $TMUX_SESSION"
        echo "To detach from session: Press Ctrl+B, then D"
        return 0
    else
        log_error "Tmux session: NOT RUNNING"

        # Check for orphaned processes
        local orphans=$(ps aux | grep -E "(bin/trader|bin/telegram_bot)" | grep -v grep | wc -l)
        if [ "$orphans" -gt 0 ]; then
            log_warning "Found $orphans orphaned process(es). Use 'stop' to clean up."
        fi

        return 1
    fi
}

# Function to run health checks
run_health_checks() {
    log_info "Running system health checks..."

    cd "$SCRIPT_DIR"

    # Check if deployment health check exists
    if [ -f "deployment/scripts/health_check.sh" ]; then
        bash deployment/scripts/health_check.sh
    elif [ -f "scripts/health_check.sh" ]; then
        bash scripts/health_check.sh
    else
        log_warning "Health check script not found"
    fi
}

# Function to show logs
show_logs() {
    log_info "Recent system logs:"

    cd "$SCRIPT_DIR"

    if session_exists; then
        echo ""
        echo "=== Live Trader Output ==="
        tmux_cmd capture-pane -t "$TMUX_SESSION:trader" -p | tail -30
        echo ""

        if tmux_cmd list-panes -t "$TMUX_SESSION:telegram" &>/dev/null; then
            echo "=== Live Telegram Output ==="
            tmux_cmd capture-pane -t "$TMUX_SESSION:telegram" -p | tail -30
            echo ""
        fi
    fi

    if [ -d "logs" ]; then
        echo ""
        echo "=== Recent Log Files ==="
        ls -lt logs/*.log 2>/dev/null | head -5
        echo ""

        local latest_trader=$(ls -t logs/trader_*.log 2>/dev/null | head -1)
        if [ ! -z "$latest_trader" ]; then
            echo "=== Latest Trader Log ==="
            tail -20 "$latest_trader"
            echo ""
        fi

        local latest_telegram=$(ls -t logs/telegram_*.log 2>/dev/null | head -1)
        if [ ! -z "$latest_telegram" ]; then
            echo "=== Latest Telegram Log ==="
            tail -20 "$latest_telegram"
            echo ""
        fi
    else
        log_warning "Logs directory not found"
    fi
}

# Main script logic
if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

# Parse arguments
parse_args "$@"

# Handle the main command
case "${@: -1}" in
    start)
        start_system
        ;;
    stop)
        stop_system
        ;;
    restart)
        stop_system
        sleep 2
        start_system
        ;;
    status)
        check_status
        ;;
    health)
        run_health_checks
        ;;
    logs)
        show_logs
        ;;
    attach)
        if session_exists; then
            log_info "Attaching to session '$TMUX_SESSION'..."
            echo "To detach: Press Ctrl+B, then D"
            sleep 1
            tmux_cmd attach -t "$TMUX_SESSION"
        else
            log_error "No session to attach to. Run 'start' first."
            exit 1
        fi
        ;;
    detach)
        log_info "To detach from tmux: Press Ctrl+B, then D"
        ;;
    *)
        echo "Unknown command: ${@: -1}"
        show_usage
        exit 1
        ;;
esac
