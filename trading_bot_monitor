0 * * * * trader /opt/trading_bot/bot/generate_performance_report.sh >> /var/log/trading_bot/performance_$(date +\%Y\%m\%d).log 2>&1

# Log rotation daily
0 2 * * * trader /opt/trading_bot/bot/rotate_logs.sh