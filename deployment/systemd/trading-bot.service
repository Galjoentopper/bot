[Unit]
Description=Automated Trading Bot with Tmux
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=trader
Group=trader
WorkingDirectory=/opt/trading_bot/bot
EnvironmentFile=/etc/trading_bot/.env
Environment=TMUX_TMPDIR=/opt/trading_bot/bot/tmux
Environment=MPLCONFIGDIR=/opt/trading_bot/bot/.cache/matplotlib
Environment=XDG_CONFIG_HOME=/opt/trading_bot/bot/.config
ExecStartPre=/bin/bash -c "cd /opt/trading_bot/bot && git pull"
ExecStart=/bin/bash -c "cd /opt/trading_bot/bot && ./scripts/tmux_manager.sh start"
ExecStop=/bin/bash -c "cd /opt/trading_bot/bot && ./scripts/tmux_manager.sh stop"
Restart=no

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/trading_bot/bot /opt/trading_bot/bot/tmux /var/log/trading_bot
ProtectHome=yes

# Resource limits
MemoryLimit=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
